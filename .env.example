# Document library — set on the Node host (not in Git)

KDRIVE_API_TOKEN=
RESIDENT_LIBRARY_DRIVE_ID=4047143
RESIDENT_LIBRARY_ROOT_ID=6
RESIDENT_LIBRARY_ROOT_NAME=Society documents
# Comma-separated kDrive folder ids hidden from resident accounts.
# Name matching also hides Bank Statements and Digital Services & Administration.
RESIDENT_LIBRARY_EXCLUDED_IDS=14,24,69,74,96,100,104,106

# Persistent directory for library.sqlite and users-seed.json
# On Infomaniak: /srv/customer/library-data (outside the git checkout)
DATA_DIR=

# Public URL used in password-reset emails
APP_BASE_URL=https://cotewall-mews.ltd

# Infomaniak SMTP (directors@ mailbox)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=directors@cotewall-mews.ltd
SMTP_PASS=
SMTP_FROM=directors@cotewall-mews.ltd
